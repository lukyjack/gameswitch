# This file is documentation; use a process manager or node --env-file=.env.
# Do not commit credentials. Runtime defaults to sandbox and loopback only.
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://127.0.0.1:3001
RUNTIME_MODE=sandbox
# For real runtime: RUNTIME_MODE=pufferpanel (see docs/deployment.md).
# PUFFERPANEL_URL=http://127.0.0.1:8080
# PUFFERPANEL_CLIENT_ID=
# PUFFERPANEL_CLIENT_SECRET=
