[Unit]
Description=GameSwitch control panel
After=network-online.target pufferpanel.service
Wants=network-online.target

[Service]
Type=simple
User=gameswitch
Group=gameswitch
WorkingDirectory=/opt/gameswitch/gameswitch
EnvironmentFile=/etc/gameswitch/gameswitch.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5
StateDirectory=gameswitch
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/gameswitch
InaccessiblePaths=-/var/run/docker.sock -/run/docker.sock
LimitNOFILE=4096
TasksMax=128
MemoryMax=768M

[Install]
WantedBy=multi-user.target
